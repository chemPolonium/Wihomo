<Window x:Class="Wihomo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Wihomo" Icon="Wihomo.ico" Height="720" Width="1000"
        MinHeight="620" MinWidth="880">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderCoreStatusTextBlock"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="内核状态: 已停止" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartCoreButton" Content="启动/重启内核" Width="105" Margin="8,0,0,0" Click="StartCoreButton_Click" />
                <Button x:Name="StopCoreButton" Content="停止内核" Width="90" Margin="8,0,0,0" Click="StopCoreButton_Click" />
                <Button x:Name="SaveAllButton" Content="保存设置并生成配置" Width="150" Margin="8,0,0,0" Click="SaveAllButton_Click" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="概览">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CoreStatusTextBlock" Grid.Row="0" FontSize="14" FontWeight="SemiBold" Text="内核状态: 未启动" />
                    <TextBlock x:Name="VersionTextBlock" Grid.Row="1" Margin="0,6,0,0" Text="内核版本: -" />
                    <TextBlock x:Name="ConnectionsTextBlock" Grid.Row="2" Margin="0,6,0,0" Text="当前连接数: -" />
                    <TextBlock x:Name="DownloadTotalTextBlock" Grid.Row="3" Margin="0,6,0,0" Text="累计下载: -" />
                    <TextBlock x:Name="UploadTotalTextBlock" Grid.Row="4" Margin="0,6,0,0" Text="累计上传: -" />
                    <TextBlock x:Name="DownloadRateTextBlock" Grid.Row="5" Margin="0,6,0,0" Text="下载速率: -" />
                    <TextBlock x:Name="UploadRateTextBlock" Grid.Row="6" Margin="0,6,0,0" Text="上传速率: -" />
                    <TextBlock x:Name="SystemProxyStatusTextBlock" Grid.Row="7" Margin="0,6,0,0" Text="系统代理: 未启用" />
                    <TextBlock x:Name="TunStatusTextBlock" Grid.Row="8" Margin="0,6,0,0" Text="TUN: 未启用" />
                </Grid>
            </TabItem>

            <TabItem Header="订阅管理">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="订阅列表">
                        <DataGrid x:Name="SubscriptionsListBox"
                                  Margin="8"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="SubscriptionsListBox_SelectionChanged"
                                  MouseDoubleClick="SubscriptionsListBox_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="55" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="已用" Binding="{Binding Used}" Width="90" />
                                <DataGridTextColumn Header="总量" Binding="{Binding Total}" Width="90" />
                                <DataGridTextColumn Header="截止日期" Binding="{Binding Expires}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="编辑订阅" Grid.Row="1" Margin="0,8,0,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="名称" />
                            <TextBox x:Name="SubscriptionNameTextBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="URL" />
                            <TextBox x:Name="SubscriptionUrlTextBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="更新间隔(秒)" />
                            <TextBox x:Name="SubscriptionIntervalTextBox" Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" Text="3600" />

                            <CheckBox x:Name="SubscriptionEnabledCheckBox" Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" Content="启用此订阅" IsChecked="True" />

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="新增/更新" Width="90" Click="AddOrUpdateSubscriptionButton_Click" />
                                <Button Content="删除" Width="70" Margin="8,0,0,0" Click="RemoveSubscriptionButton_Click" />
                                <Button Content="更新选中订阅" Width="110" Margin="8,0,0,0" Click="UpdateSelectedProviderButton_Click" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="外部资源">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap"
                                   Text="由 mihomo 负责下载和自动更新 GEO 数据库；此页面仅配置下载地址与更新策略。" />

                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="GeoIP 数据库" />
                        <TextBox x:Name="GeoIpUrlTextBox" Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" />

                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="GeoSite 数据库" />
                        <TextBox x:Name="GeoSiteUrlTextBox" Grid.Row="2" Grid.Column="1" Margin="8,8,0,0" />

                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="MMDB 数据库" />
                        <TextBox x:Name="MmdbUrlTextBox" Grid.Row="3" Grid.Column="1" Margin="8,8,0,0" />

                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="ASN 数据库" />
                        <TextBox x:Name="AsnUrlTextBox" Grid.Row="4" Grid.Column="1" Margin="8,8,0,0" />

                        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Geodata 数据模式" />
                        <ComboBox x:Name="GeoDataModeComboBox" Grid.Row="5" Grid.Column="1" Width="180"
                                  HorizontalAlignment="Left" Margin="8,8,0,0">
                            <ComboBoxItem Content="MMDB（默认）" />
                            <ComboBoxItem Content="DAT" />
                        </ComboBox>

                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="8,8,0,0">
                            <CheckBox x:Name="GeoAutoUpdateCheckBox" Content="自动更新 GEO 数据" VerticalAlignment="Center" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="更新间隔（小时）" />
                            <TextBox x:Name="GeoUpdateIntervalTextBox" Width="80" Margin="8,0,0,0" />
                        </StackPanel>

                        <Button Grid.Row="7" Grid.Column="1" Width="190" HorizontalAlignment="Left" Margin="8,12,0,0"
                                Content="保存外部资源设置并生成配置" Click="SaveAllButton_Click" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="代理组">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="刷新代理组" Width="100" Click="RefreshProxyGroupsButton_Click" />
                        <Button Content="测试所有节点" Width="110" Margin="8,0,0,0" Click="TestAllProxyDelaysButton_Click" />
                        <TextBlock x:Name="SelectedGroupStatusTextBlock" Margin="12,4,0,0" Text="当前组: -" />
                        <TextBlock x:Name="AllDelayTestStatusTextBlock" Margin="12,4,0,0" Text="等待测速" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="代理组" Grid.Column="0" Margin="0,0,8,0">
                            <ListBox x:Name="ProxyGroupsListBox" Margin="8" SelectionChanged="ProxyGroupsListBox_SelectionChanged" />
                        </GroupBox>

                        <GroupBox Header="组成员" Grid.Column="1">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ProxyGroupCurrentTextBlock" Text="当前选择: -" />
                                <DataGrid x:Name="ProxyGroupMembersDataGrid"
                                          Grid.Row="1"
                                          Margin="0,8,0,8"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="*" />
                                        <DataGridTextColumn Header="延迟" Binding="{Binding Delay}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="切换到选中节点" Width="120" Click="ApplySelectedProxyButton_Click" />
                                    <Button Content="测试选中延迟" Width="120" Margin="8,0,0,0" Click="TestProxyDelayButton_Click" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock VerticalAlignment="Center" Text="测试 URL" />
                                    <TextBox x:Name="DelayTestUrlTextBox" Width="270" Margin="8,0,0,0" Text="https://www.youtube.com/generate_204" />
                                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="超时(ms)" />
                                    <TextBox x:Name="DelayTestTimeoutTextBox" Width="80" Margin="8,0,0,0" Text="5000" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="YAML 覆写">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="对订阅配置进行 YAML 深度合并。key! 强制整体覆盖对象；+key 前置数组；key+ 追加数组。" />
                    <TextBox x:Name="RuleOverridesTextBox" Grid.Row="1" Margin="0,8,0,0"
                             AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </TabItem>

            <TabItem Header="规则">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="刷新规则" Width="100" Click="RefreshRulesAndConnectionsButton_Click" />
                        <TextBlock Margin="12,4,0,0" Text="显示订阅规则与当前生效规则" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Margin="0,0,8,0" Header="订阅规则">
                            <ListBox x:Name="SubscriptionRulesListBox" Margin="8" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="当前规则">
                            <ListBox x:Name="ActiveRulesListBox" Margin="8" />
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="连接">
                <Grid Margin="8">
                    <DataGrid x:Name="ConnectionsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="入口" Binding="{Binding Source}" Width="1*" />
                            <DataGridTextColumn Header="出口" Binding="{Binding Destination}" Width="3*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="节点组" Binding="{Binding UsedProxy}" Width="*" />
                            <DataGridTextColumn Header="规则" Binding="{Binding Rule}" Width="*" />
                            <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="日志">
               <Grid Margin="8">
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto" />
                       <RowDefinition Height="*" />
                   </Grid.RowDefinitions>
                   <StackPanel Orientation="Horizontal">
                       <Button Content="清空日志" Width="90" Click="ClearLogsButton_Click" />
                   </StackPanel>
                   <TextBox x:Name="LogsTextBox"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto" />
               </Grid>
            </TabItem>

            <TabItem Header="内核设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="内核可执行文件路径" />
                        <TextBox x:Name="CorePathTextBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="工作目录" />
                        <TextBox x:Name="CoreWorkDirTextBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="External Controller Host" />
                        <TextBox x:Name="ControllerHostTextBox" Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="External Controller Port" />
                        <TextBox x:Name="ControllerPortTextBox" Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Mixed Port" />
                        <TextBox x:Name="MixedPortTextBox" Grid.Row="4" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="SOCKS Port" />
                        <TextBox x:Name="SocksPortTextBox" Grid.Row="5" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="HTTP Port" />
                        <TextBox x:Name="HttpPortTextBox" Grid.Row="6" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="Secret" />
                        <TextBox x:Name="SecretTextBox" Grid.Row="7" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="统计刷新间隔(秒)" />
                        <TextBox x:Name="StatsRefreshTextBox" Grid.Row="8" Grid.Column="1" Margin="8,0,0,8" />

                        <CheckBox x:Name="StartCoreOnProgramStartCheckBox" Grid.Row="9" Grid.Column="1" Margin="8,0,0,8" Content="启动程序时自动启动内核" />

                        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="10" Grid.Column="1" Margin="8,0,0,8" Content="登录用户时启动 Wihomo" />

                        <CheckBox x:Name="EnableSystemProxyCheckBox" Grid.Row="11" Grid.Column="1" Margin="8,0,0,8" Content="启动内核时启用系统代理，停止内核时关闭" />

                        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,8">
                            <CheckBox x:Name="EnableTunCheckBox" Content="启用 TUN" VerticalAlignment="Center" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="TUN Stack" />
                            <ComboBox x:Name="TunStackComboBox" Width="120" Margin="8,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="mixed" />
                                <ComboBoxItem Content="system" />
                                <ComboBoxItem Content="gvisor" />
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Row="13" Grid.Column="1" Width="130" HorizontalAlignment="Left" Content="保存设置"
                                Click="SaveSettingsOnlyButton_Click" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" CornerRadius="4">
            <TextBlock x:Name="MessageTextBlock" Text="就绪" />
        </Border>
    </Grid>
</Window>

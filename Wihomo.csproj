<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Wihomo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 测试工程内嵌于工程根目录，需显式排除，否则会被默认 **/*.cs 通配编译进主程序集 -->
  <ItemGroup>
    <Compile Remove="Wihomo.Tests\**" />
    <None Remove="Wihomo.Tests\**" />
    <Page Remove="Wihomo.Tests\**" />
    <Content Remove="Wihomo.Tests\**" />
    <Compile Remove="artifacts\**" />
    <Compile Remove="mihomo-src\**" />
    <Compile Remove="tmp-mihomo-test\**" />
    <Content Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\geodata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\core\mihomo-windows-amd64-v3.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Wihomo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>

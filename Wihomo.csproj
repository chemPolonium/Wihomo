<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Wihomo</RootNamespace>
    <AssemblyName>Wihomo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Branding\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 仅使用 WinForms 的 NotifyIcon；禁止 WindowsDesktop SDK 再跑 WPF 的 XAML 编译 -->
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <!-- 未启用 AOT/裁剪，ObservableProperty 字段生成器在 WinRT 场景的提示不适用 -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 测试工程内嵌于工程根目录，需显式排除，否则会被默认 **/*.cs 通配编译进主程序集 -->
  <ItemGroup>
    <Compile Remove="Wihomo.Tests\**" />
    <None Remove="Wihomo.Tests\**" />
    <Page Remove="Wihomo.Tests\**" />
    <Content Remove="Wihomo.Tests\**" />
    <Compile Remove="artifacts\**" />
    <Compile Remove="mihomo-src\**" />
    <Compile Remove="tmp-mihomo-test\**" />
    <Content Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\geodata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\core\mihomo-windows-amd64-v3.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Wihomo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Branding\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
  </ItemGroup>

  <!-- 单工程 MSIX：让“打包”菜单与能力生效 -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

</Project>

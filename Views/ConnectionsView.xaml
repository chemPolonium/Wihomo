<UserControl
    x:Class="Wihomo.Views.ConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wihomo.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Border Style="{StaticResource Card}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TableHeaderText}" Text="入口" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="出口" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="类型" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="节点组" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="规则" />
                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderText}" Text="速度" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    Padding="0"
                    ItemContainerStyle="{StaticResource TableRowContainer}"
                    ItemsSource="{x:Bind ViewModel.Telemetry.Connections}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TableCellText}" Text="{x:Bind Source, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Text="{x:Bind Destination, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Text="{x:Bind Type, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}" Text="{x:Bind UsedProxy, Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource TableCellText}" Text="{x:Bind Rule, Mode=OneWay}" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TableCellText}" Text="{x:Bind Speed, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>

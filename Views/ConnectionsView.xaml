<UserControl
    x:Class="Wihomo.Views.ConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wihomo.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="连接" />

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Telemetry.Connections}">
            <ListView.Header>
                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="当前连接" />
                    <Grid Padding="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="入口" />
                        <TextBlock Grid.Column="1" Text="出口" />
                        <TextBlock Grid.Column="2" Text="类型" />
                        <TextBlock Grid.Column="3" Text="节点组" />
                        <TextBlock Grid.Column="4" Text="规则" />
                        <TextBlock Grid.Column="5" Text="速度" />
                    </Grid>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind Source, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Source, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Destination, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Destination, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Type, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="3"
                            Text="{x:Bind UsedProxy, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind UsedProxy, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="4"
                            Text="{x:Bind Rule, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Rule, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Speed, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

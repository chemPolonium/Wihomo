<UserControl
    x:Class="Wihomo.Views.GeoResourcesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="外部资源" />
            <Expander
                Header="GEO 数据"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="由 mihomo 负责下载和自动更新 GEO 数据库；此页面仅配置下载地址与更新策略。"
                        TextWrapping="Wrap" />

                    <TextBox
                        Header="GeoIP 数据库"
                        Text="{x:Bind ViewModel.Settings.GeoIpUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Header="GeoSite 数据库"
                        Text="{x:Bind ViewModel.Settings.GeoSiteUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Header="MMDB 数据库"
                        Text="{x:Bind ViewModel.Settings.MmdbUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Header="ASN 数据库"
                        Text="{x:Bind ViewModel.Settings.AsnUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox
                        Header="Geodata 数据模式"
                        DisplayMemberPath="Display"
                        ItemsSource="{x:Bind ViewModel.Settings.GeoDataModeOptionList}"
                        SelectedItem="{x:Bind ViewModel.Settings.SelectedGeoDataMode, Mode=TwoWay}" />

                    <StackPanel Spacing="12">
                        <CheckBox
                            Content="自动更新 GEO 数据"
                            IsChecked="{x:Bind ViewModel.Settings.GeoAutoUpdate, Mode=TwoWay}" />
                        <TextBox
                            Header="更新间隔（小时）"
                            InputScope="Number"
                            Text="{x:Bind ViewModel.Settings.GeoUpdateIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="保存外部资源设置并生成配置"
                            Command="{x:Bind ViewModel.SaveAllCommand}" />
                        <Button
                            Content="手动更新 GEO 数据"
                            Command="{x:Bind ViewModel.ManualUpdateGeoDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>

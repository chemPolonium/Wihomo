<UserControl
    x:Class="Wihomo.Views.ProxyGroupsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wihomo.ViewModels"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Padding="24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="代理组" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CommandBar
                HorizontalAlignment="Left"
                DefaultLabelPosition="Right">
                <AppBarButton
                    Icon="Refresh"
                    Label="刷新"
                    Command="{x:Bind ViewModel.RefreshProxyGroupsCommand}"
                    IsEnabled="{x:Bind ViewModel.IsCoreRunning, Mode=OneWay}" />
                <AppBarButton
                    Icon="Play"
                    Label="测试全部"
                    Command="{x:Bind ViewModel.TestAllDelaysCommand}"
                    IsEnabled="{x:Bind ViewModel.IsCoreRunning, Mode=OneWay}" />
                <AppBarSeparator />
                <AppBarButton
                    Icon="Setting"
                    Label="测速设置"
                    Click="DelaySettings_Click" />
            </CommandBar>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ProxyGroups.IsTestingAllDelays, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.ProxyGroups.IsTestingAllDelays, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ProxyGroups.AllDelayStatusText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ListView
                ItemsSource="{x:Bind ViewModel.ProxyGroups.Groups}"
                SelectedItem="{x:Bind ViewModel.ProxyGroups.SelectedGroup, Mode=TwoWay}">
                <ListView.Header>
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="组列表" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProxyGroupViewModel">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Subtitle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind ViewModel.ProxyGroups.CurrentSelectionText, Mode=OneWay}" />

                <ListView
                    Grid.Row="1"
                    IsItemClickEnabled="{x:Bind ViewModel.IsCoreRunning, Mode=OneWay}"
                    ItemClick="MemberList_ItemClick"
                    ItemsSource="{x:Bind ViewModel.ProxyGroups.SelectedGroup.Members, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.ProxyGroups.SelectedMember, Mode=TwoWay}">
                    <ListView.Header>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="组成员" />
                            <Grid Padding="16,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="节点" />
                                <TextBlock Grid.Column="1" Text="延迟" />
                            </Grid>
                        </StackPanel>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProxyMemberViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind NodeName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind NodeName}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Delay, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="暂无代理组"
            Visibility="{x:Bind ViewModel.ProxyGroups.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

        <ContentDialog
            x:Name="DelaySettingsDialog"
            Grid.RowSpan="3"
            Title="测速设置"
            CloseButtonText="关闭"
            DefaultButton="Close">
            <StackPanel Spacing="12">
                <TextBox
                    Header="测试 URL"
                    Text="{x:Bind ViewModel.Settings.ProxyTestUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <TextBox
                    Header="超时（ms）"
                    InputScope="Number"
                    Text="{x:Bind ViewModel.Settings.ProxyTestTimeoutText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>

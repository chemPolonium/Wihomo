<UserControl
    x:Class="Wihomo.Views.SubscriptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wihomo.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionTitle}" Text="订阅列表" />

                <Grid Grid.Row="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="状态" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="名称" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="已用" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="总量" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="截止日期" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        Padding="0"
                        ItemContainerStyle="{StaticResource TableRowContainer}"
                        ItemsSource="{x:Bind ViewModel.Subscriptions.Items}"
                        SelectedItem="{x:Bind ViewModel.Subscriptions.SelectedSubscription, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubscriptionRowViewModel">
                                <Grid Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TableCellText}" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Text="{x:Bind Used}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}" Text="{x:Bind Total}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource TableCellText}" Text="{x:Bind Expires}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionTitle}" Text="编辑订阅" />

                <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource FormLabel}" Text="名称" />
                    <TextBox
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Subscriptions.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="URL" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Subscriptions.EditUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="更新间隔(秒)" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Subscriptions.EditIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button MinWidth="90" Content="新增/更新" Command="{x:Bind ViewModel.AddOrUpdateSubscriptionCommand}" />
                        <Button MinWidth="90" Content="删除订阅" Command="{x:Bind ViewModel.RemoveSubscriptionCommand}" />
                        <Button MinWidth="90" Content="激活订阅" Command="{x:Bind ViewModel.ActivateSubscriptionCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

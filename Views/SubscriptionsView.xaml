<UserControl
    x:Class="Wihomo.Views.SubscriptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wihomo.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="订阅管理" />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Subscriptions.Items}"
            SelectedItem="{x:Bind ViewModel.Subscriptions.SelectedSubscription, Mode=TwoWay}">
            <ListView.Header>
                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="订阅列表" />
                    <Grid Padding="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态" />
                        <TextBlock Grid.Column="1" Text="名称" />
                        <TextBlock Grid.Column="2" Text="已用" />
                        <TextBlock Grid.Column="3" Text="总量" />
                        <TextBlock Grid.Column="4" Text="截止日期" />
                    </Grid>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SubscriptionRowViewModel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Status}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Used}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Total}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Expires}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="暂无订阅"
            Visibility="{x:Bind ViewModel.Subscriptions.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

        <Expander
            Grid.Row="2"
            Header="编辑订阅"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="True">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="12" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        Header="名称"
                        Text="{x:Bind ViewModel.Subscriptions.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Grid.Column="1"
                        Header="更新间隔（秒）"
                        InputScope="Number"
                        Text="{x:Bind ViewModel.Subscriptions.EditIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Header="URL"
                        Text="{x:Bind ViewModel.Subscriptions.EditUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="新增/更新"
                        Command="{x:Bind ViewModel.AddOrUpdateSubscriptionCommand}" />
                    <Button
                        Content="删除订阅"
                        Command="{x:Bind ViewModel.RemoveSubscriptionCommand}"
                        IsEnabled="{x:Bind ViewModel.Subscriptions.HasSelection, Mode=OneWay}" />
                    <Button
                        Content="激活订阅"
                        Command="{x:Bind ViewModel.ActivateSubscriptionCommand}"
                        IsEnabled="{x:Bind ViewModel.Subscriptions.HasSelection, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>

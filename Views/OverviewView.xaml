<UserControl
    x:Class="Wihomo.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="概览" />
            <Expander
                Header="运行状态"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Telemetry.VersionText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Telemetry.ConnectionsText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Telemetry.DownloadTotalText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Telemetry.UploadTotalText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Telemetry.DownloadRateText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Telemetry.UploadRateText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Telemetry.SystemProxyStatusText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind AppVersionText}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
